# Committed on purpose: no secrets here, only name mapping.
#
# Supabase gives you NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# This app (Create React App) reads REACT_APP_* names, so these two lines pass the values on.
# Put the real values in .env.local (your machine) or in the host's build variables
# (Cloudflare → Settings → Build → Variables). Without them the app runs in local-only mode.
REACT_APP_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
REACT_APP_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
