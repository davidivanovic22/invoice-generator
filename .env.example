# Copy to .env.local and paste the two values from Supabase → Project Settings → API.
# The publishable (anon) key is safe to ship: row-level security protects the data.
# Never put the secret / service-role key here.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Local Docker setup: npm run db:local writes these values into .env.local.
