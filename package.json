{
  "name": "invoice-generator",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "exceljs": "^4.4.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "mammoth": "^1.13.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "react-scripts": "5.0.1",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "typescript": "5.9",
    "workbox-core": "^6.6.0",
    "workbox-expiration": "^6.6.0",
    "workbox-precaching": "^6.6.0",
    "workbox-routing": "^6.6.0",
    "workbox-strategies": "^6.6.0",
    "zod": "^4.6.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false",
    "typecheck": "tsc --noEmit",
    "eject": "react-scripts eject",
    "eslint-fix": "eslint --fix",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,storage-api,realtime,postgres-meta,supavisor",
    "db:stop": "supabase stop",
    "db:local": "npm run db:start && node scripts/configure-local-db.cjs",
    "db:migrate:local": "supabase migration up --local",
    "db:test": "node supabase/tests/rls.test.mjs",
    "db:test:relational": "python supabase/tests/relational.test.py",
    "db:test:accounting": "python supabase/tests/accounting.test.py",
    "db:backup:local": "python scripts/accounting_backup.py create",
    "db:backup:verify": "python scripts/accounting_backup.py verify",
    "db:backup:restore": "python scripts/accounting_backup.py restore",
    "e2e:database": "node e2e/database-first.cjs",
    "e2e:relational": "node scripts/test-relational.cjs",
    "e2e:accounting": "node e2e/relational.cjs --accounting",
    "e2e": "node e2e/smoke.cjs",
    "e2e:sharing": "node e2e/sharing.cjs",
    "db:check": "node supabase/tests/check-project.mjs"
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router$": "<rootDir>/node_modules/react-router/dist/development/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "playwright": "^1.63.0",
    "postcss": "^8.5.8",
    "supabase": "^2.119.0",
    "tailwindcss": "^3.4.19"
  },
  "overrides": {
    "react-scripts": {
      "typescript": "$typescript"
    }
  }
}
